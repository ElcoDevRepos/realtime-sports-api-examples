# Realtime Sports API key (https://www.realtimesportsapi.com/signup). Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# Discord channel webhook URL: Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# What to follow. Soccer uses SPORT=soccer (LEAGUE=eng.1, usa.1, uefa.champions, ...); "football" is American football.
SPORT=football
LEAGUE=nfl

# Optional: only post games involving this team (abbreviation like KC, or team id). Empty = whole league.
TEAM=

# auto   = try the WebSocket stream, fall back to REST polling if your plan has no WebSocket access
# stream = WebSocket only
# poll   = REST polling only
MODE=auto

# Polling fallback intervals. Keep LIVE >= 30: data is typically 20-30 s behind live play anyway.
POLL_LIVE_SECONDS=60
POLL_IDLE_MINUTES=15
# Max time to sleep when the scoreboard says the next game is far away (hours)
POLL_MAX_IDLE_HOURS=6
