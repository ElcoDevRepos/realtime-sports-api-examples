# Realtime Sports API key, used only by register.js (https://www.realtimesportsapi.com/signup).
# Webhooks need a paid plan. Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# Signing secret returned once by `node register.js create ...` (or revealed in the dashboard).
WEBHOOK_SECRET=

# Where the server listens
PORT=3000
WEBHOOK_PATH=/webhook

# Optional: only alert on these event types (comma separated). Empty = all.
# event.live, event.score_change, event.status_change, event.play, event.final
ALERT_EVENTS=event.score_change,event.final

# Optional: forward each alert to a Slack or Discord incoming webhook URL
FORWARD_URL=
