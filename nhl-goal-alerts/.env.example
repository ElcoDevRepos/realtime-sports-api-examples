# Realtime Sports API key (https://www.realtimesportsapi.com/signup). Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# Optional: follow one team by abbreviation (e.g. CAR, TOR, EDM) or team id. Empty = every NHL game.
TEAM=

# Optional: phone push. Install the ntfy app, subscribe to a hard-to-guess topic, and put its URL here.
NTFY_URL=
# Optional: a command to run for every goal by TEAM (your goal horn), e.g.:
#   macOS:  afplay ~/horn.mp3      Linux:  aplay ~/horn.wav      smart plug/light: curl -X POST ...
GOAL_COMMAND=

# Poll interval while games are live (minimum 30; data is typically 20-30 s behind live play)
POLL_SECONDS=30
