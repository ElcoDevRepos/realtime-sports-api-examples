# Realtime Sports API key (https://www.realtimesportsapi.com/signup). Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# From @BotFather (/newbot). Treat it like a password.
TELEGRAM_BOT_TOKEN=
# Your chat, group or channel id (see README for how to find it). Channels can use @channelname.
TELEGRAM_CHAT_ID=

# What to follow. Soccer uses SPORT=soccer (LEAGUE=eng.1, usa.1, ...); "football" is American football.
SPORT=hockey
LEAGUE=nhl
# Optional: one team, by abbreviation (e.g. CAR) or team id
TEAM=

# Poll interval while games are live (minimum 30; data is typically 20-30 s behind live play anyway)
POLL_SECONDS=60
# Poll interval when nothing is live and no start time is known
IDLE_MINUTES=15
