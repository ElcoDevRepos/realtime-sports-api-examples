# Realtime Sports API key (https://www.realtimesportsapi.com/signup). Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# Slack Incoming Webhook URL (api.slack.com/apps > your app > Incoming Webhooks). Treat it like a password.
SLACK_WEBHOOK_URL=

# What to follow. Soccer uses SPORT=soccer (LEAGUE=eng.1, usa.1, ...); "football" is American football.
SPORT=football
LEAGUE=nfl

# Poll interval while games are live (minimum 30; data is typically 20-30 s behind live play anyway)
POLL_SECONDS=60
# Poll interval when nothing is live and no game is about to start
IDLE_MINUTES=15
