# Realtime Sports API key (https://www.realtimesportsapi.com/signup). Never commit your real .env.
REALTIME_SPORTS_API_KEY=your_api_key_here

# nba, or mens-college-basketball (box scores once its season starts in November)
LEAGUE=nba
# Optional: one team, by abbreviation (e.g. BOS, LAL, NY) or team id
TEAM=
# Optional: comma-separated player names to alert on (exact names as in the box score). Empty = everyone.
WATCH=
# Point totals that trigger an alert
POINT_THRESHOLDS=20,30,40,50
# Optional: Discord or Slack webhook URL for the alerts
WEBHOOK_URL=

# Box score refresh while games are live (minimum 30; data is typically 20-30 s behind live play)
POLL_SECONDS=60
